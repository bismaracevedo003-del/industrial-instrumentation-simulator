# Instrumentation real I/O configuration (placeholders only)
# Copy to .env only on a real deployment and replace every <placeholder>.

MODE=real
REAL_STRICT=true
LOG_LEVEL=INFO

# real I/O is Modbus TCP; the simulator remains the default when MODE is unset
MODBUS_HOST=192.168.1.20
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_LOOP=FT-301
MODBUS_REGISTER_TYPE=input
MODBUS_PV_REGISTER=0
MODBUS_PV_SCALE=0.1
MODBUS_PV_OFFSET=0
MODBUS_OUTPUT_REGISTER=1
MODBUS_OUTPUT_SCALE=10
MODBUS_TIMEOUT=3

# valve / actuator writes stay disabled unless explicitly enabled
ALLOW_WRITES=false
